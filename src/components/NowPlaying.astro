<span class="now-playing" data-now-playing hidden></span>

<script>
  import type { NowPlaying } from '../lib/spotify';

  async function render(root: HTMLElement) {
    try {
      const response = await fetch('/api/now-playing');
      if (!response.ok) return;
      const data: NowPlaying | null = await response.json();
      if (!data) return;

      const link = document.createElement('a');
      link.href = data.url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = data.title;

      root.append(`♪ ${data.playing ? 'now playing' : 'last played'}: `, link, ` — ${data.artist}`);
      root.hidden = false;
    } catch {}
  }

  document.querySelectorAll<HTMLElement>('[data-now-playing]').forEach(render);
</script>

<style is:global>
  .now-playing { color: var(--fg-dim); font-size: 0.9rem; margin-left: 0.5rem; }
</style>
